{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "next dev",
    "dev:local": "dotenv -e .env.localdb -- next dev",
    "db:migrate:local": "dotenv -e .env.localdb -- tsx lib/db/migrate.ts && dotenv -e .env.localdb -- tsx lib/db/migrate.ts --test",
    "test:local": "dotenv -e .env.localdb -- vitest run",
    "build": "tsx lib/db/migrate.ts --vercel-production && next build",
    "start": "next start",
    "test": "dotenv -e .env.local -- vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- tsx lib/db/migrate.ts",
    "db:migrate:test": "dotenv -e .env.local -- tsx lib/db/migrate.ts --test",
    "db:seed": "dotenv -e .env.local -- tsx lib/db/seed.ts",
    "db:seed:catalog": "dotenv -e .env.local -- tsx scripts/import-seed-catalog.ts",
    "db:reconcile-retailer-skus": "dotenv -e .env.local -- tsx scripts/reconcile-retailer-skus.ts",
    "db:backfill-receipt-locations": "dotenv -e .env.local -- tsx scripts/backfill-receipt-store-locations.ts",
    "db:split-collapsed-products": "dotenv -e .env.local -- tsx scripts/split-collapsed-products.ts",
    "db:backfill-prices": "dotenv -e .env.local -- tsx scripts/backfill-prices.ts",
    "db:backup": "dotenv -e .env.local -- tsx scripts/backup-db.ts",
    "receipt-eval:export": "dotenv -e .env.local -- tsx scripts/receipt-eval/export-dataset.ts",
    "receipt-eval:run": "dotenv -e .env.local -- tsx scripts/receipt-eval/run.ts",
    "db:set-admin": "dotenv -e .env.local -- tsx scripts/set-admin.ts",
    "db:import-stores": "dotenv -e .env.local -- tsx scripts/import-stores.ts",
    "db:albert-flyers": "dotenv -e .env.local -- tsx scripts/albert-flyers.ts",
    "db:penny-flyers": "dotenv -e .env.local -- tsx scripts/penny-flyers.ts",
    "db:billa-flyers": "dotenv -e .env.local -- tsx scripts/billa-flyers.ts",
    "db:lidl-flyers": "dotenv -e .env.local -- tsx scripts/lidl-flyers.ts",
    "db:remove-albert-misread": "dotenv -e .env.local -- tsx scripts/remove-albert-misread-products.ts",
    "db:recategorize-products": "dotenv -e .env.local -- tsx scripts/recategorize-products.ts",
    "db:reclassify-products": "dotenv -e .env.local -- tsx scripts/reclassify-products.ts",
    "db:brand-categories": "dotenv -e .env.local -- tsx scripts/apply-brand-categories.ts",
    "db:assign-product-types": "dotenv -e .env.local -- tsx scripts/assign-product-types.ts",
    "db:move-new-subcategories": "dotenv -e .env.local -- tsx scripts/move-to-new-subcategories.ts",
    "gcp:oidc-key": "tsx scripts/generate-gcp-oidc-key.ts",
    "push:vapid-keys": "tsx scripts/generate-vapid-keys.ts",
    "cf:build": "dotenv -v BUILD_TARGET=cloudflare -- opennextjs-cloudflare build",
    "cf:preview": "wrangler dev",
    "cf:deploy:staging": "opennextjs-cloudflare deploy --env staging",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "test:e2e": "playwright test",
    "db:recipes:recepty-cz": "dotenv -e .env.local -- tsx scripts/import-recipes-recepty-cz.ts",
    "db:recipes:apetit": "dotenv -e .env.local -- tsx scripts/import-recipes-apetit.ts",
    "db:recipes:toprecepty": "dotenv -e .env.local -- tsx scripts/import-recipes-toprecepty.ts",
    "db:recipes:vareni": "dotenv -e .env.local -- tsx scripts/import-recipes-vareni.ts",
    "db:recipes:backfill-images": "dotenv -e .env.local -- tsx scripts/backfill-recipe-images.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/serverless": "1.1.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/oidc": "^3.8.8",
    "ai": "^7.0.107",
    "aws4fetch": "1.0.20",
    "better-auth": "1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.16.0",
    "next": "16.3.8",
    "pg": "^8.23.0",
    "react": "^19",
    "react-dom": "^19",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "11.0.0",
    "drizzle-kit": "0.31.10",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "^5.0.1",
    "wrangler": "4.138.0",
    "shadcn": "^4.11.0"
  }
}
