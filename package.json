{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "dotenv -e .env.local -- vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- tsx lib/db/migrate.ts",
    "db:migrate:test": "dotenv -e .env.local -- tsx lib/db/migrate.ts --test",
    "db:seed": "dotenv -e .env.local -- tsx lib/db/seed.ts",
    "db:backfill-receipt-locations": "dotenv -e .env.local -- tsx scripts/backfill-receipt-store-locations.ts",
    "db:split-collapsed-products": "dotenv -e .env.local -- tsx scripts/split-collapsed-products.ts",
    "db:backfill-prices": "dotenv -e .env.local -- tsx scripts/backfill-prices.ts",
    "db:import-stores": "dotenv -e .env.local -- tsx scripts/import-stores.ts",
    "db:albert-flyers": "dotenv -e .env.local -- tsx scripts/albert-flyers.ts",
    "db:migrate-blob-to-r2": "dotenv -e .env.local -- tsx scripts/migrate-vercel-blob-to-r2.ts",
    "gcp:oidc-key": "tsx scripts/generate-gcp-oidc-key.ts",
    "push:vapid-keys": "tsx scripts/generate-vapid-keys.ts",
    "cf:build": "BUILD_TARGET=cloudflare opennextjs-cloudflare build",
    "cf:preview": "wrangler dev",
    "cf:deploy:staging": "opennextjs-cloudflare deploy --env staging",
    "cf:deploy": "opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/serverless": "1.1.0",
    "@vercel/analytics": "1.6.1",
    "@vercel/blob": "^2.8.0",
    "@vercel/oidc": "^3.8.8",
    "ai": "^7.0.107",
    "aws4fetch": "1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.16.0",
    "next": "16.3.3",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.11.0",
    "sharp": "0.35.3",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "11.0.0",
    "drizzle-kit": "0.31.10",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.7.3",
    "vitest": "^5.0.1",
    "wrangler": "4.138.0"
  }
}
