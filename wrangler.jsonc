// Cloudflare Workers configuration — PREPARED, NOT DEPLOYED. Production runs on Vercel.
// Runbook: docs/cloudflare-deployment.md. Secrets are never written here (see .dev.vars.example).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shopping-buddy",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "shopping-buddy" }],
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "shopping-buddy-next-cache" }],
  "keep_vars": true,
  "vars": {},
  "limits": { "cpu_ms": 300000 },
  "observability": { "enabled": true },
  "triggers": {
    "crons": [
      "0 13 * * *",
      "0 8 * * *",
      "0 15 * * 0",
      "0 3 * * 1",
      "0 4 * * 1",
      "0 5 * * 3",
      "10 5 * * 2",
      "10 13 * * 2",
      "20 5 * * 2",
      "30 5 * * 4",
      "30 11 * * 4",
      "40 5 * * 5",
      "40 13 * * 5",
      "50 5 * * 6",
      "50 11 * * 6",
      "0 6 * * 0",
      "20 6 * * 1",
      "20 12 * * 1",
      "20 18 * * 1",
      "0 21 * * 2",
      "0 23 * * 2",
      "10 23 * * 2",
      "20 21 * * 0",
      "20 23 * * 0",
      "20 21 * * 3",
      "20 23 * * 3"
    ]
  },
  "env": {
    "staging": {
      "name": "shopping-buddy-staging",
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "shopping-buddy-staging" }],
      "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "shopping-buddy-next-cache-staging" }],
      "vars": { "STORAGE_PROVIDER": "r2" },
      "triggers": { "crons": [] }
    }
  }
}