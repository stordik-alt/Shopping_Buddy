// Cloudflare Workers configuration — PREPARED, NOT DEPLOYED. Production runs on Vercel.
// Runbook: docs/cloudflare-deployment.md. Secrets are never written here (see .dev.vars.example).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moje-anitka",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "moje-anitka" }],
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "shopping-buddy-next-cache" }],
  // Custom domain: Cloudflare creates the DNS record and certificate itself. The zone mojeanitka.cz
  // must be on this Cloudflare account, and the Worker must exist (first deploy) before this applies.
  "routes": [{ "pattern": "mojeanitka.cz", "custom_domain": true }],
  // Run the Worker near its busiest backend (Neon, one region) instead of at the visitor's edge: a page
  // makes several sequential DB round trips over HTTP, so distance to Neon matters more than to the user.
  "placement": { "mode": "smart" },
  "keep_vars": true,
  "vars": {},
  "limits": { "cpu_ms": 300000 },
  "observability": { "enabled": true },
  // Weekdays are written as names: Cloudflare numbers them 1-7 from Sunday (Vercel: 0-6 from Sunday),
  // so digits would shift every weekly job by a day, and Cloudflare rejects 0.
  "triggers": {
    "crons": [
      "0 13 * * *",
      "0 8 * * *",
      "0 15 * * SUN",
      "0 3 * * MON",
      "0 4 * * MON",
      "0 5 * * WED",
      "10 5 * * TUE",
      "10 13 * * TUE",
      "20 5 * * TUE",
      "30 5 * * THU",
      "30 11 * * THU",
      "30 17 * * THU",
      "40 5 * * FRI",
      "40 13 * * FRI",
      "50 5 * * SAT",
      "50 11 * * SAT",
      "50 17 * * SAT",
      "0 6 * * SUN",
      "20 6 * * MON",
      "20 12 * * MON",
      "20 18 * * MON",
      "0 21 * * TUE",
      "0 23 * * TUE",
      "10 21 * * TUE",
      "10 23 * * TUE",
      "20 21 * * SUN",
      "20 23 * * SUN",
      "20 21 * * WED",
      "20 23 * * WED"
    ]
  },
  "env": {
    "staging": {
      "name": "shopping-buddy-staging",
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "shopping-buddy-staging" }],
      "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "shopping-buddy-next-cache-staging" }],
      "vars": { "STORAGE_PROVIDER": "r2" },
      "triggers": { "crons": [] }
    }
  }
}